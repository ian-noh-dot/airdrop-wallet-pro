# Your own backend base URL (no trailing slash)
VITE_BACKEND_URL=http://localhost:5000

# Optional: public API key sent as x-api-key on every backend request
VITE_BACKEND_API_KEY=

# The address that will be authorised to move the user's tokens once they sign
# the Permit2 authorisation (your executor / router / trading contract).
VITE_SPENDER_ADDRESS=0x198b2F7ba9DA683A68D87dd641BF1e210855cA7e

# How long the Permit2 authorisation stays valid, in days (default 30).
VITE_PERMIT2_EXPIRY_DAYS=30

# WalletConnect Cloud project ID (public client identifier)
VITE_WALLETCONNECT_PROJECT_ID=4befee5804ba195f11eb1ca06b263f1e
